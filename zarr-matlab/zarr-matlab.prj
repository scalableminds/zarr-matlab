<deployment-project plugin="plugin.toolbox" plugin-version="1.0">
  <configuration build-checksum="" file="zarr-matlab.prj" name="zarr-matlab" target="target.toolbox" target-name="Package Toolbox">
    <param.appname>zarr-matlab</param.appname>
    <param.authnamewatermark>scalable minds</param.authnamewatermark>
    <param.email>hello@scalableminds.com</param.email>
    <param.company>scalable minds</param.company>
    <param.summary>Zarr v3 implementation for MATLAB based on zarrs</param.summary>
    <param.description>A high-performance Zarr v3 implementation for MATLAB, powered by the Rust-based zarrs library.

Features:
- Read and write Zarr v3 arrays
- Support for chunking and sharding
- Compression codecs: zstd (default), gzip, blosc
- HTTP/HTTPS remote access (read-only)
- Group hierarchy support
- Attributes for arrays and groups

Supported data types: uint8, uint16, uint32, uint64, int8, int16, int32, int64, float32, float64</param.description>
    <param.screenshot />
    <param.version>0.0.1</param.version>
    <param.output>${PROJECT_ROOT}/zarr-matlab.mltbx</param.output>
    <param.products.name>
      <item>MATLAB</item>
    </param.products.name>
    <param.products.id>
      <item>1</item>
    </param.products.id>
    <param.products.version>
      <item>9.14</item>
    </param.products.version>
    <param.platforms />
    <param.guid>a1b2c3d4-e5f6-7890-abcd-ef1234567890</param.guid>
    <param.exclude.filters>rust/**
tests/*
zarrBuild.m
zarrPackage.m
zarr-matlab.mltbx</param.exclude.filters>
    <param.exclude.pcodedmfiles>true</param.exclude.pcodedmfiles>
    <param.examples />
    <param.demosxml />
    <param.apps />
    <param.registered.apps />
    <param.docs />
    <param.getting.started.guide />
    <param.matlabpath.excludes />
    <param.javaclasspath.excludes />
    <param.exported.on.package>false</param.exported.on.package>
    <param.required.addons />
    <param.matlab.project.id />
    <param.matlab.project.name />
    <param.release.start>R2022a</param.release.start>
    <param.release.end>latest</param.release.end>
    <param.release.current.only>false</param.release.current.only>
    <param.compatiblity.windows>true</param.compatiblity.windows>
    <param.compatiblity.macos>true</param.compatiblity.macos>
    <param.compatiblity.linux>true</param.compatiblity.linux>
    <param.compatiblity.gpu>false</param.compatiblity.gpu>
    <param.compatiblity.mlhdlc>false</param.compatiblity.mlhdlc>
    <param.compatiblity.polyspace>false</param.compatiblity.polyspace>
    <param.installer.hierarchical.enabled>false</param.installer.hierarchical.enabled>
    <unset>
      <param.screenshot />
      <param.platforms />
      <param.exclude.pcodedmfiles />
      <param.examples />
      <param.demosxml />
      <param.apps />
      <param.registered.apps />
      <param.docs />
      <param.getting.started.guide />
      <param.matlabpath.excludes />
      <param.javaclasspath.excludes />
      <param.exported.on.package />
      <param.required.addons />
      <param.matlab.project.id />
      <param.matlab.project.name />
      <param.release.current.only />
      <param.compatiblity.gpu />
      <param.compatiblity.mlhdlc />
      <param.compatiblity.polyspace />
      <param.installer.hierarchical.enabled />
    </unset>
    <fileset.rootdir>
      <file>${PROJECT_ROOT}</file>
    </fileset.rootdir>
    <fileset.rootfiles>
      <file>${PROJECT_ROOT}/ZarrArray.m</file>
      <file>${PROJECT_ROOT}/ZarrGroup.m</file>
      <file>${PROJECT_ROOT}/zarrMex.mexmaca64</file>
    </fileset.rootfiles>
    <fileset.depfun.included />
    <fileset.depfun.excluded />
    <fileset.package />
    <build-deliverables>
      <file location="${PROJECT_ROOT}" name="zarr-matlab.mltbx" optional="false">/Users/norman/scalableminds/tools/webknossos-wrap/zarr-matlab/zarr-matlab.mltbx</file>
    </build-deliverables>
    <workflow />
    <matlab>
      <root>/Applications/MATLAB_R2024a.app</root>
      <toolboxes />
    </matlab>
    <platform>
      <unix>true</unix>
      <mac>true</mac>
      <windows>true</windows>
      <win2k>false</win2k>
      <winxp>false</winxp>
      <vista>false</vista>
      <linux>false</linux>
      <solaris>false</solaris>
      <osver>15.2</osver>
      <os32>true</os32>
      <os64>false</os64>
      <arch>maca64</arch>
      <matlab>true</matlab>
    </platform>
  </configuration>
</deployment-project>
